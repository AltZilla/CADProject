# API Base URL (leave empty if using direct Lambda URLs)
VITE_API_BASE_URL=

# AWS Lambda Function URLs
VITE_HOTSPOTS_URL=https://your-hotspots-lambda-url.lambda-url.ap-south-1.on.aws
VITE_SIMULATION_URL=https://your-simulation-lambda-url.lambda-url.ap-south-1.on.aws
VITE_ALERTS_URL=https://your-alerts-lambda-url.lambda-url.ap-south-1.on.aws

# MapTiler Cloud (optional; restrict the public key to your app's HTTP origins)
VITE_MAPTILER_KEY=
VITE_MAPTILER_STYLE_ID=01a1005c-9e31-702d-a792-5d6b5a578af9
# Optional full style URL override. Leave empty to use MapTiler when a key is set,
# otherwise the no-key OpenFreeMap Liberty style is used.
VITE_MAP_STYLE=
