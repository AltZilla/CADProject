# ============================================================
# Wildfire Early Warning Platform -- Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- NASA FIRMS API ---
# Register free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Key is 32 alphanumeric characters.
FIRMS_API_KEY=your_32char_key_here

# --- DynamoDB Table Names ---
HOTSPOTS_TABLE=WildfireHotspots
SIMULATION_CACHE_TABLE=SimulationCache
ALERT_ZONES_TABLE=AlertZones
ALERT_DEDUP_TABLE=AlertDedup

# --- S3 ---
# Replace {your_account_id} with your 12-digit AWS account ID
GEOJSON_BUCKET=wildfire-geojson-cache-{your_account_id}-us-east-1

# --- SNS ---
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:{your_account_id}:WildfireAlerts

# --- AWS ---
AWS_REGION=us-east-1

# --- Local Dev Only ---
# DynamoDB Local endpoint (run: docker run -p 8000:8000 amazon/dynamodb-local)
DYNAMODB_ENDPOINT=http://localhost:8000

# --- Frontend (Vite) ---
# Set to your CloudFront distribution URL after deployment.
# For local dev against SAM local, use http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
